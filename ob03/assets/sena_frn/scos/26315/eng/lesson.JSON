: "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "frn4le03ob03re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "\u00c9crivez un courriel \u00e0 un(e) ami(e).", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation. \n", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 2, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "frn4le03ob03re2aud01", "coverimg": "frn4le03ob03re2img01.jpg", "images": [{"image": "frn4le03ob03re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "frn4le03ob03re2img01.jpg", "text": "Ch\u00e8re Charlotte, <br><br>Salutations du Costa Rica ! Nous sommes arriv\u00e9s, il y a deux jours. Nous sommes \u00e0 San Jos\u00e9, la plus grande ville du pays. Je vis des moments formidables\u00a0! San Jos\u00e9 a des mus\u00e9es vraiment int\u00e9ressants. Les\nrues sont bond\u00e9es et tr\u00e8s anim\u00e9es !", "id": 1, "time": "100"}, {"image": "frn4le03ob03re2img02.jpg", "text": "Les march\u00e9s sont remplis de produits que je ne reconnais pas, comme les plantains (fruit de la famille des\nbananes) et le yucca (un l\u00e9gume racine). J'ai m\u00eame essay\u00e9 leurs d\u00e9licieuses \"chips de yucca\". Incroyable !", "id": 2, "time": "18000"}, {"image": "frn4le03ob03re2img04.jpg", "text": "Les restaurants aussi sont \u00e9tonnants et meilleur march\u00e9 que ceux que nous avons  \u00e0 la maison. \u00c9vite  cependant la cuisine de rue : mon coll\u00e8gue de travail  est tomb\u00e9 gravement malade ; il a eu mal au ventre pour une semaine !", "id": 3, "time": "32000"}, {"image": "frn4le03ob03re2img03.jpg", "text": "Je dois y aller maintenant. Demain nous allons au volcan Irazcu. Imagine \u00e7a, un volcan en activit\u00e9  !<br><br>J'esp\u00e8re que tu vas bien ! <br>\nJean", "id": 4, "time": "45000"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Jean : La vie \u00e0 bord d'un navire de croisi\u00e8re", "type": "lesson_name"}, {"content": "Salutations du Costa Rica", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "scholar > Out and About in the City > Mexico City", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant fait usage d'une information pr\u00e9cise concernant les voyages et les vacances dans des situations sociales. ", "type": "primary"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_1"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_2"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_3"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_4"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_5"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_6"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_7"}, {"content": "L'apprenant identifie de l'information g\u00e9n\u00e9rale dans des conversations courtes \u00e0 l'\u00e9crit et \u00e0 l'oral.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Le pass\u00e9 compos\u00e9 ", "type": "heading"}, {"content": "Le pass\u00e9 compos\u00e9 exprime une action ponctuelle qui s'est d\u00e9roul\u00e9e et achev\u00e9e dans le pass\u00e9.  <br><br>Le pass\u00e9 compos\u00e9 est le temps de la narration qui s'utilise beaucoup \u00e0 l'oral (avec le pr\u00e9sent).  ", "type": "describer"}, {"content": "Nous sommes arriv\u00e9s il y a deux jours.", "type": "example"}, {"content": "Nous sommes all\u00e9s au march\u00e9.", "type": "example"}, {"content": "Mes coll\u00e8gues sont tomb\u00e9s malades.", "type": "example"}, {"content": "J'ai m\u00eame essay\u00e9 de nouveaux aliments !", "type": "example"}, {"content": "Le pass\u00e9 compos\u00e9 est un temps form\u00e9 de l'auxiliaire <span class=\"strong italic\">avoir</span> ou <span class=\"strong italic\">\u00eatre</span> au pr\u00e9sent  suivi du participe  pass\u00e9 du verbe conjugu\u00e9.  <br><br>Le participe pass\u00e9 peut \u00eatre r\u00e9gulier (<span class=\"italic\">regard\u00e9</span>, <span class=\"italic\">fini</span>, <span class=\"italic\">attendu</span>) ou irr\u00e9gulier (<span class=\"italic\">ouvert</span>, <span class=\"italic\">eu</span>, <span class=\"italic\">\u00e9crit</span>). ", "type": "text"}, {"content": "Avez-vous eu une bonne journ\u00e9e ?", "type": "example"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Arriver\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Ouvrir\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"je suis arriv\u00e9(e)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"j'ai ouvert\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tu es arriv\u00e9(e)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tu as ouvert\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"il/elle/on est arriv\u00e9(e)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"il/elle/on a ouvert\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"nous sommes arriv\u00e9(e)s\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"nous avons ouvert\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous \u00eates arriv\u00e9(e)(s)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous avez ouvert\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ils/elles sont arriv\u00e9(e)s\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ils/elles ont ouvert\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "Pour les questions au pass\u00e9, vous utilisez l'auxiliaire <span class=\"italic\">avoir</span> suivi par le sujet et le participe pass\u00e9 du verbe, tel que <span class=\"italic\">Avez-vous demand\u00e9... ?</span>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "malade", "type": "name"}, {"content": "se sentir en mauvaise condition physique", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Mon coll\u00e8gue de travail est tomb\u00e9 malade apr\u00e8s avoir mang\u00e9 de la cuisine de rue.", "type": "example"}, {"content": "frn4le03ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots que vous utilisez pour parler des endroits int\u00e9ressants dans une ville.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "la cuisine de rue", "type": "name"}, {"content": "nourriture que vous achetez et mangez dans la rue", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple :  La cuisine de rue sur le boulevard Massena est d\u00e9licieuse.", "type": "example"}, {"content": "frn4le03ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "reconna\u00eetre", "type": "name"}, {"content": "identifier quelque chose ou quelqu'un", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Je ne reconnais pas ces aliments.", "type": "example"}, {"content": "frn4le03ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "anim\u00e9, anim\u00e9e", "type": "name"}, {"content": "plein de vie", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Les rues de San Jos\u00e9 sont vraiment anim\u00e9es.", "type": "example"}, {"content": "frn4le03ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "actif, active", "type": "name"}, {"content": "d\u00e9crit un volcan qui est sur le point d'exploser", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple :  Demain, nous allons visiter un volcan actif.", "type": "example"}, {"content": "frn4le03ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "yucca", "type": "name"}, {"content": "l\u00e9gume racine d'Am\u00e9rique du sud", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Le yucca est un aliment que je ne connaissais pas. ", "type": "example"}, {"content": "frn4le03ob03aud06", "type": "audio"}]}, {"content": "frn4le03ob03re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "\u00c9crivez un courriel court d\u00e9crivant  une ville que vous avez visit\u00e9e.", "type": "text"}, {"content": "\u00c9crivez de 6 \u00e0 8 phrases.", "type": "text"}, {"content": "\u00c9crivez ce que vous avez fait l\u00e0.", "type": "text"}, {"content": "Lisez votre courriel \u00e0 voix haute \u00e0 votre camarade.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "J'\u00e9cris un courriel \u00e0 un(e) ami(e) sur une ville que j'ai visit\u00e9e.", "type": "text"}, {"content": "J'\u00e9cris des phrases compl\u00e8tes.", "type": "text"}, {"content": "Je lis mon courriel \u00e0 voix haute.", "type": "text"}]}]}